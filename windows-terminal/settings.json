{
  "//": "Merged into Windows Terminal's settings.json by apply.py. Mirrors the WezTerm setup.",
  "schemes": [
    {
      "name": "WezTerm Night",
      "background": "#1B1840",
      "foreground": "#B3B3B3",
      "cursorColor": "#52AD70",
      "selectionBackground": "#4D52F8",
      "black": "#000000",
      "red": "#CC5555",
      "green": "#55CC55",
      "yellow": "#CDCD55",
      "blue": "#5455CB",
      "purple": "#CC55CC",
      "cyan": "#7ACACA",
      "white": "#CCCCCC",
      "brightBlack": "#555555",
      "brightRed": "#FF5555",
      "brightGreen": "#55FF55",
      "brightYellow": "#FFFF55",
      "brightBlue": "#5555FF",
      "brightPurple": "#FF55FF",
      "brightCyan": "#55FFFF",
      "brightWhite": "#FFFFFF"
    }
  ],
  "profileDefaults": {
    "colorScheme": "WezTerm Night",
    "opacity": 75,
    "useAcrylic": false,
    "font": { "size": 12 },
    "padding": "8"
  },
  "actions": [
    { "keys": "alt+t", "command": "newTab" },
    { "keys": "alt+w", "command": "closeTab" },
    { "keys": "alt+q", "command": { "action": "splitPane", "split": "right" } },
    { "keys": "alt+b", "command": { "action": "splitPane", "split": "down" } },
    { "keys": "alt+m", "command": "closePane" },
    { "keys": "alt+h", "command": { "action": "moveFocus", "direction": "left" } },
    { "keys": "alt+j", "command": { "action": "moveFocus", "direction": "down" } },
    { "keys": "alt+k", "command": { "action": "moveFocus", "direction": "up" } },
    { "keys": "alt+l", "command": { "action": "moveFocus", "direction": "right" } },
    { "keys": "alt+z", "command": "togglePaneZoom" },
    { "keys": "alt+f", "command": "toggleFullscreen" },
    { "keys": "alt+c", "command": { "action": "copy", "singleLine": false } },
    { "keys": "alt+v", "command": "paste" },
    { "keys": "alt+1", "command": { "action": "switchToTab", "index": 0 } },
    { "keys": "alt+2", "command": { "action": "switchToTab", "index": 1 } },
    { "keys": "alt+3", "command": { "action": "switchToTab", "index": 2 } },
    { "keys": "alt+4", "command": { "action": "switchToTab", "index": 3 } },
    { "keys": "alt+5", "command": { "action": "switchToTab", "index": 4 } },
    { "keys": "alt+6", "command": { "action": "switchToTab", "index": 5 } },
    { "keys": "alt+7", "command": { "action": "switchToTab", "index": 6 } },
    { "keys": "alt+8", "command": { "action": "switchToTab", "index": 7 } },
    { "keys": "alt+9", "command": { "action": "switchToTab", "index": 8 } }
  ]
}
